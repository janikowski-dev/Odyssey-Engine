<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hierarchy="clr-namespace:OdysseyEditor.UI.ViewModels.Hierarchy"
                    xmlns:console="clr-namespace:OdysseyEditor.UI.ViewModels.Console"
                    xmlns:workspace="clr-namespace:OdysseyEditor.UI.ViewModels.Workspace"
                    xmlns:inspector="clr-namespace:OdysseyEditor.UI.ViewModels.Inspector"
                    xmlns:controlsBar="clr-namespace:OdysseyEditor.UI.ViewModels.ControlsBar"
                    xmlns:views="clr-namespace:OdysseyEditor.UI.Views">

    <DataTemplate DataType="{x:Type workspace:WorkspaceViewModel}">
        <views:WorkspaceView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type hierarchy:HierarchyViewModel}">
        <views:HierarchyView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type inspector:InspectorViewModel}">
        <views:InspectorView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type console:ConsoleViewModel}">
        <views:ConsoleView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type controlsBar:ControlsBarViewModel}">
        <views:ControlsBar/>
    </DataTemplate>

</ResourceDictionary>