<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="C.Bg.Deep">#1E1E1E</Color>
    <Color x:Key="C.Bg.Surface">#252526</Color>
    <Color x:Key="C.Bg.Hover">#2A2D2E</Color>
    <Color x:Key="C.Bg.Control">#3C3C3C</Color>
    <Color x:Key="C.Bg.Accent">#505050</Color>
    <Color x:Key="C.Bg.Pressed">#424242</Color>
    <Color x:Key="C.Border.Panel">#3A3A3A</Color>
    <Color x:Key="C.Border.Control">#555555</Color>
    <Color x:Key="C.Fg.Primary">#D4D4D4</Color>
    <Color x:Key="C.Fg.Muted">#858585</Color>
    <Color x:Key="C.Selection">#094771</Color>
    <Color x:Key="C.Warning">#FF8C00</Color>

    <!-- Console -->
    <SolidColorBrush x:Key="ConsoleBorderBrush" Color="{StaticResource C.Border.Panel}"/>
    <SolidColorBrush x:Key="ConsoleHeaderBackgroundBrush" Color="{StaticResource C.Bg.Surface}"/>
    <SolidColorBrush x:Key="ConsoleContentBackgroundBrush" Color="{StaticResource C.Bg.Deep}"/>
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="{StaticResource C.Fg.Primary}"/>
    <SolidColorBrush x:Key="ConsoleListForegroundBrush" Color="{StaticResource C.Fg.Primary}"/>

    <!-- Hierarchy -->
    <SolidColorBrush x:Key="HierarchyBgBrush" Color="{StaticResource C.Bg.Deep}"/>
    <SolidColorBrush x:Key="HierarchyGroupBgBrush" Color="{StaticResource C.Bg.Surface}"/>
    <SolidColorBrush x:Key="HierarchyBorderBrush" Color="{StaticResource C.Border.Panel}"/>
    <SolidColorBrush x:Key="HierarchyFgBrush" Color="{StaticResource C.Fg.Primary}"/>
    <SolidColorBrush x:Key="HierarchyMutedBrush" Color="{StaticResource C.Fg.Muted}"/>
    <SolidColorBrush x:Key="HierarchySelectedBrush" Color="{StaticResource C.Selection}"/>
    <SolidColorBrush x:Key="HierarchyHoverBrush" Color="{StaticResource C.Bg.Hover}"/>

    <!-- Toolbar / Controls Bar -->
    <SolidColorBrush x:Key="ToolbarBgBrush" Color="{StaticResource C.Bg.Control}"/>
    <SolidColorBrush x:Key="ToolbarFgBrush" Color="{StaticResource C.Fg.Primary}"/>
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="{StaticResource C.Border.Control}"/>
    <SolidColorBrush x:Key="ToolbarHoverBgBrush" Color="{StaticResource C.Bg.Accent}"/>
    <SolidColorBrush x:Key="ToolbarHoverBorderBrush" Color="{StaticResource C.Border.Control}"/>
    <SolidColorBrush x:Key="ToolbarPressedBgBrush" Color="{StaticResource C.Bg.Pressed}"/>

    <!-- Workspace / DataGrid -->
    <SolidColorBrush x:Key="WorkspaceBgBrush" Color="{StaticResource C.Bg.Deep}"/>
    <SolidColorBrush x:Key="WorkspaceMutedBrush" Color="{StaticResource C.Fg.Muted}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource C.Warning}"/>
    <SolidColorBrush x:Key="GridHeaderBgBrush" Color="{StaticResource C.Bg.Surface}"/>
    <SolidColorBrush x:Key="GridRowBgBrush" Color="{StaticResource C.Bg.Deep}"/>
    <SolidColorBrush x:Key="GridAltRowBgBrush" Color="{StaticResource C.Bg.Surface}"/>
    <SolidColorBrush x:Key="GridSelectionBrush" Color="{StaticResource C.Selection}"/>
    <SolidColorBrush x:Key="GridBorderBrush" Color="{StaticResource C.Border.Panel}"/>
    <SolidColorBrush x:Key="GridFgBrush" Color="{StaticResource C.Fg.Primary}"/>

    <!-- Inspector / Inputs -->
    <SolidColorBrush x:Key="InspectorBgBrush" Color="{StaticResource C.Bg.Deep}"/>
    <SolidColorBrush x:Key="InspectorLabelBrush" Color="{StaticResource C.Fg.Muted}"/>
    <SolidColorBrush x:Key="InspectorFgBrush" Color="{StaticResource C.Fg.Primary}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource C.Bg.Control}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource C.Border.Control}"/>
    <SolidColorBrush x:Key="InputFgBrush" Color="{StaticResource C.Fg.Primary}"/>

</ResourceDictionary>