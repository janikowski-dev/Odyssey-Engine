<UserControl x:Class="OdysseyEditor.UI.Views.ControlsBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controlsBar="clr-namespace:OdysseyEditor.UI.ViewModels.ControlsBar"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=controlsBar:ControlsBarViewModel, IsDesignTimeCreatable=False}">

    <DockPanel Background="{StaticResource ToolbarBgBrush}" Height="28">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">

            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding SaveCommand}"
                    Content="💾 Save"/>

            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding LoadCommand}"
                    Content="💾 Load"/>

            <Separator Width="1" Height="16" Background="{StaticResource ToolbarSeparatorBrush}" Margin="3,0"/>

            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding UndoCommand}"
                    ToolTip="Undo (Ctrl+Z)"
                    Content="↩ Undo"/>

            <Button Style="{StaticResource ToolbarButton}"
                    Command="{Binding RedoCommand}"
                    ToolTip="Redo (Ctrl+Y)"
                    Content="↪ Redo"/>

        </StackPanel>
    </DockPanel>

</UserControl>