<UserControl x:Class="OdysseyEditor.UI.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:workspace="clr-namespace:OdysseyEditor.UI.ViewModels.Workspace"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=workspace:WorkspaceViewModel, IsDesignTimeCreatable=False}">

    <Grid Background="{StaticResource WorkspaceBgBrush}">

        <TextBlock Text="Editor is not open."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource WorkspaceMutedBrush}"/>

    </Grid>

</UserControl>