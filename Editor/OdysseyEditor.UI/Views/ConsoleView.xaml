<UserControl x:Class="OdysseyEditor.UI.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:console="clr-namespace:OdysseyEditor.UI.ViewModels.Console"
             xmlns:models="clr-namespace:OdysseyEditor.Application.Models;assembly=OdysseyEditor.Application"
             xmlns:behaviors="clr-namespace:OdysseyEditor.UI.Behaviors"
             mc:Ignorable="d"
             Focusable="True"
             d:DataContext="{d:DesignInstance Type=console:ConsoleViewModel, IsDesignTimeCreatable=False}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource ConsoleBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource ConsoleHeaderBackgroundBrush}"
                Padding="6,4">
            
            <DockPanel>
                
                <Button DockPanel.Dock="Right"
                        Command="{Binding ToggleCommand}"
                        Style="{StaticResource ConsoleToggleButtonStyle}"
                        ToolTip="Toggle Console">
                    <TextBlock Style="{StaticResource ConsoleToggleArrowStyle}"
                               Text="{Binding IsExpanded, Converter={StaticResource BoolToArrowConverter}}"/>
                </Button>
                
                <TextBlock Text="{Binding HeaderText}"
                           Foreground="{StaticResource ConsoleForegroundBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Height="200"
                BorderBrush="{StaticResource ConsoleBorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource ConsoleContentBackgroundBrush}"
                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
            
            <ListBox ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     ItemContainerStyle="{StaticResource ConsoleListBoxItemStyle}">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LogEntry}">
                        <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                   TextWrapping="NoWrap">
                            <Run Text="["/>
                            <Run Text="{Binding FormattedTimestamp, Mode=OneWay}"/>
                            <Run Text="] "/>
                            <Run Text="{Binding Message, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <i:Interaction.Behaviors>
                    <behaviors:ScrollToBottomBehavior/>
                </i:Interaction.Behaviors>

            </ListBox>
        </Border>
    </Grid>

</UserControl>