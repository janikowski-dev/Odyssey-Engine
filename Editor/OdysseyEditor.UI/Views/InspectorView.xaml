<UserControl x:Class="OdysseyEditor.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:inspector="clr-namespace:OdysseyEditor.UI.ViewModels.Inspector"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:InspectorViewModel, IsDesignTimeCreatable=False}">

    <Border Style="{StaticResource PanelBorderStyle}">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource ControlBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,1"
                    Padding="10,10">
                <TextBlock Text="Inspector"
                           FontWeight="SemiBold"/>
            </Border>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type inspector:ComponentInspector}">

                            <Expander IsExpanded="True"
                                      Margin="0,0,0,6">

                                <Expander.Header>
                                    <TextBlock Text="{Binding Type}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ForegroundBrush}"/>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Properties}"
                                              Margin="8,6,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource ForegroundSecondaryBrush}"/>

                                                <ContentPresenter Grid.Column="1"
                                                                  Content="{Binding}"
                                                                  ContentTemplateSelector="{StaticResource PropertyFieldSelector}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>