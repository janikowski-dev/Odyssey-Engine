<UserControl x:Class="OdysseyEditor.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:inspector="clr-namespace:OdysseyEditor.UI.ViewModels.Inspector"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:InspectorViewModel, IsDesignTimeCreatable=False}">

    <Border Background="{StaticResource InspectorBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        </ScrollViewer>
    </Border>
</UserControl>