<UserControl x:Class="OdysseyEditor.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:inspector="clr-namespace:OdysseyEditor.UI.ViewModels.Inspector"
             xmlns:proxies="clr-namespace:OdysseyEditor.UI.Proxies"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inspector:InspectorViewModel, IsDesignTimeCreatable=False}">

    <Border Style="{StaticResource PanelBorderStyle}">
        <Border.Resources>
            <proxies:InspectorProxy x:Key="InspectorProxy" Data="{Binding}" />
        </Border.Resources>
        
        <DockPanel>
            <DockPanel.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add Component"
                              ItemsSource="{Binding AvailableComponentTypes}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="Command"
                                        Value="{Binding DataContext.AddComponentCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </ContextMenu>
            </DockPanel.ContextMenu>
            
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource ControlBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,3"
                    Padding="10,8, 10, 10">
                <TextBlock Text="Inspector" FontWeight="SemiBold"/>
            </Border>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type inspector:ComponentInspector}">
                            <Border BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="0,0,0,1">
                                <Expander IsExpanded="True"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                        
                                    <Expander.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete Component"
                                                      Command="{Binding Data.RemoveComponentCommand, Source={StaticResource InspectorProxy}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Expander.ContextMenu>
                        
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource PascalCaseToWordsConverter}}"
                                                   Foreground="{StaticResource ForegroundBrush}"/>
                                    </Expander.Header>
                        
                                    <ItemsControl ItemsSource="{Binding Properties}" Margin="8,6,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                        
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                        
                                                    <ContentPresenter Grid.Column="1"
                                                                      Margin="0,0,8,0"
                                                                      Content="{Binding}"
                                                                      ContentTemplateSelector="{StaticResource PropertyFieldSelector}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>