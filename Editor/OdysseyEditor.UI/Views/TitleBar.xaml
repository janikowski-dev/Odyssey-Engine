<UserControl x:Class="OdysseyEditor.UI.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:main="clr-namespace:OdysseyEditor.UI.ViewModels.Main"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="40"
             d:DataContext="{d:DesignInstance Type=main:MainWindowViewModel, IsDesignTimeCreatable=True}">

    <Border Style="{StaticResource PanelBorderStyle}">
        <Grid Background="{StaticResource ControlBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
    
            <TextBlock Grid.Column="0" Text="Odyssey Editor"
                       VerticalAlignment="Center" Margin="14,0"
                       Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold" FontSize="12"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        Margin="-1, -1, -1, -2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
    
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" ToolTip="Minimize">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Click">
                            <b:InvokeCommandAction Command="{Binding MinimizeCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
    
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" ToolTip="Resize">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Click">
                            <b:InvokeCommandAction Command="{Binding ResizeCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
    
                <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Click">
                            <b:InvokeCommandAction Command="{Binding CloseCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>