<UserControl x:Class="OdysseyEditor.UI.Views.HierarchyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hierarchy="clr-namespace:OdysseyEditor.UI.ViewModels.Hierarchy"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="250"
             d:DataContext="{d:DesignInstance Type=hierarchy:HierarchyViewModel, IsDesignTimeCreatable=False}">

    <Border Style="{StaticResource PanelBorderStyle}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Hierarchy"
                       Margin="10,8"
                       FontWeight="SemiBold"/>

            <ListBox ItemsSource="{Binding Entities}"
                     SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='Entity {0}'}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>

</UserControl>